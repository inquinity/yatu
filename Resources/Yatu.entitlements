<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One entitlement, the same one upstream's Lite app ships: Yatu asks Finder for
  the current folder and asks the chosen terminal to open it. Nothing else.
  Adding to this file is a security decision — see docs/ROADMAP.md §3.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
