#!/bin/bash
#
# Read or bump Yatu's version. The single source of truth is the VERSION file at
# the repo root: two lines, the marketing version then the build number.
#
#   1.0.0     <- CFBundleShortVersionString
#   1         <- CFBundleVersion
#
# The build number only ever goes up. It is NOT reset when the version changes,
# which this script used to do on the stated grounds that Apple expects it --
# Apple permits it for App Store trains, and it is not what you want anywhere
# else. Resetting made CFBundleVersion carry no information at all: 1.0.0, 1.0.1
# and 1.0.2 all shipped as build 1, so nothing could order two copies of the
# bundle by it, and a local build was indistinguishable from the release it was
# built on top of. A single monotonic integer is the whole point of the field.
#
# bin/build.sh reads these and stamps them into Info.plist. This replaces the
# Version.xcconfig an Xcode project would carry (docs/DESIGN.md, M1).
#
# The full colour palette is declared in every script by convention, so
# the set is identical everywhere; not every script uses every colour.
# shellcheck disable=SC2034
set -euo pipefail

# Always operate on the repo, not on the caller's directory.
cd "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Define color codes for terminal output
COLOR_GREEN="\e[32m"         # Used for success messages and instructions
COLOR_RED="\e[31m"           # Used for error messages and warnings
COLOR_YELLOW="\e[33m"        # Used for help text, lists, and informational content
COLOR_MAGENTA="\e[35m"       # Available for general use
COLOR_CYAN="\e[36m"          # Available for general use
COLOR_BLUE="\e[34m"          # Available for general use; does not show on screen well
COLOR_BRIGHTYELLOW="\e[93m"  # Used for highlighting important actions and status
COLOR_RESET="\e[0m"          # Used to reset color formatting

# Function to print colored output
print_colored() {
    local color=$1
    local message=$2
    printf "${color}%s${COLOR_RESET}\n" "$message"
}

# Overridable so bin/test-scripts.sh can exercise this against a scratch file
# rather than the repo's own VERSION. Give it an absolute path: this script has
# already cd'd to the repo root by the time it is read.
VERSION_FILE="${VERSION_FILE:-VERSION}"
DRY_RUN=false

usage() {
    print_colored "$COLOR_YELLOW" "Usage: $(basename "$0") [command] [options]

Commands:
  (none)            Print the version and build, e.g. \"1.0.0 build 1\"
  short             Print the marketing version only, e.g. \"1.0.0\"
  build             Print the build number only, e.g. \"1\"
  set <version>     Set the marketing version; the build number goes up with it
  bump major|minor|patch
                    Increment that segment; the build number goes up with it
  bump build        Increment the build number, leaving the version alone

The build number is never reset. It is a single monotonic integer, which is
what CFBundleVersion is for.

Options:
  -n, --dry-run     Show what would be written without writing it
  -h, --help        Show this help

The release flow (just release) calls 'set' or 'bump'; builds call 'short' and
'build'. Nothing here touches git."
}

die() {
    print_colored "$COLOR_RED" "error: $1"
    exit 1
}

# Read the version file into the two globals the commands operate on.
read_version() {
    [[ -f "$VERSION_FILE" ]] || die "$VERSION_FILE not found"
    current_version="$(sed -n '1p' "$VERSION_FILE" | tr -d '[:space:]')"
    current_build="$(sed -n '2p' "$VERSION_FILE" | tr -d '[:space:]')"

    [[ "$current_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
        || die "line 1 of $VERSION_FILE is not a MAJOR.MINOR.PATCH version: '$current_version'"
    [[ "$current_build" =~ ^[0-9]+$ ]] \
        || die "line 2 of $VERSION_FILE is not a build number: '$current_build'"
}

# Write the two values back, or describe the write under --dry-run.
write_version() {
    local new_version=$1 new_build=$2

    if [[ "$DRY_RUN" == true ]]; then
        print_colored "$COLOR_BRIGHTYELLOW" \
            "would write $VERSION_FILE: $current_version build $current_build -> $new_version build $new_build"
        return
    fi

    printf '%s\n%s\n' "$new_version" "$new_build" > "$VERSION_FILE"
    print_colored "$COLOR_GREEN" "$VERSION_FILE: $current_version build $current_build -> $new_version build $new_build"
}

# bump <segment>; the build number goes up with it and is never reset.
bump_segment() {
    local segment=$1
    local major minor patch next_build
    IFS=. read -r major minor patch <<< "$current_version"
    next_build=$((current_build + 1))

    case "$segment" in
        major) write_version "$((major + 1)).0.0" "$next_build" ;;
        minor) write_version "$major.$((minor + 1)).0" "$next_build" ;;
        patch) write_version "$major.$minor.$((patch + 1))" "$next_build" ;;
        build) write_version "$current_version" "$((current_build + 1))" ;;
        *) die "unknown segment '$segment' (expected major, minor, patch or build)" ;;
    esac
}

# Collect options first so they may appear before or after the command.
positional_arguments=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)    usage; exit 0 ;;
        -n|--dry-run) DRY_RUN=true; shift ;;
        -*)           die "unknown option: $1" ;;
        *)            positional_arguments+=("$1"); shift ;;
    esac
done

read_version

case "${positional_arguments[0]:-}" in
    "")      printf '%s build %s\n' "$current_version" "$current_build" ;;
    short)   printf '%s\n' "$current_version" ;;
    build)   printf '%s\n' "$current_build" ;;
    set)
        new_version="${positional_arguments[1]:-}"
        [[ -n "$new_version" ]] || die "set requires a version, e.g. 'bin/ver set 1.1.0'"
        [[ "$new_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] \
            || die "'$new_version' is not a MAJOR.MINOR.PATCH version"
        write_version "$new_version" "$((current_build + 1))"
        ;;
    bump)
        segment="${positional_arguments[1]:-}"
        [[ -n "$segment" ]] || die "bump requires a segment: major, minor, patch or build"
        bump_segment "$segment"
        ;;
    *) die "unknown command '${positional_arguments[0]}' (try --help)" ;;
esac
